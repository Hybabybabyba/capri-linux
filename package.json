{
  "name": "capri-desktop",
  "version": "0.2.0",
  "description": "Capri, an autonomous desktop companion for Arch Linux (Hyprland / Wayland), powered by Groq.",
  "author": "mochiiwuff",
  "repository": "github:mochiiwuff/capri-desktop",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "bootstrap": "bash bin/bootstrap.sh",
    "dist": "electron-builder --linux AppImage tar.gz",
    "dist:appimage": "electron-builder --linux AppImage",
    "dist:dir": "electron-builder --linux dir"
  },
  "keywords": [
    "groq",
    "desktop-companion",
    "electron",
    "hyprland",
    "wayland",
    "arch-linux",
    "cyberpunk"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0"
  },
  "build": {
    "appId": "capri.desktop",
    "productName": "Capri",
    "files": [
      "src/**",
      "assets/**",
      "package.json",
      "LICENSE"
    ],
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "executableName": "capri-desktop",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "icon": "assets/icons/capri.png",
      "category": "Utility",
      "synopsis": "Autonomous desktop companion for Linux"
    },
    "asarUnpack": [
      "src/main/tools/**",
      "src/main/hooks/**",
      "src/main/shell-helpers.sh"
    ]
  }
}
