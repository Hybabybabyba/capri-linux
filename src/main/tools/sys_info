#!/usr/bin/env bash
set -uo pipefail

cpu_usage() {
  local a b
  read -r _ a1 a2 a3 a4 a5 a6 a7 _ < /proc/stat
  sleep 0.3
  read -r _ b1 b2 b3 b4 b5 b6 b7 _ < /proc/stat
  a=$((a1 + a2 + a3 + a4 + a5 + a6 + a7)); b=$((b1 + b2 + b3 + b4 + b5 + b6 + b7))
  local idle=$(( (b4 + b5) - (a4 + a5) )) total=$(( b - a ))
  [ "$total" -gt 0 ] && echo "$(( 100 * (total - idle) / total ))%" || echo '?'
}

echo "время: $(date '+%F %H:%M'), аптайм: $(uptime -p | sed 's/^up //')"
echo "CPU: $(cpu_usage), load: $(cut -d' ' -f1-3 /proc/loadavg), ядер: $(nproc)"
free -h | awk '/^Mem:/ {print "RAM: занято " $3 " из " $2 ", доступно " $7} /^Swap:/ {print "swap: " $3 " из " $2}'
df -h / | awk 'NR==2 {print "диск /: занято " $3 " из " $2 " (" $5 ")"}'

for bat in /sys/class/power_supply/BAT*; do
  [ -r "$bat/capacity" ] && echo "батарея: $(cat "$bat/capacity")%, $(cat "$bat/status" 2>/dev/null)"
done
t="$(sensors 2>/dev/null | grep -m1 -E '^(Package id 0|Tctl|CPU):' | grep -oE '\+[0-9.]+°C' | head -1)"
[ -n "$t" ] && echo "температура CPU: $t"

command -v pamixer >/dev/null && echo "громкость: $(pamixer --get-volume 2>/dev/null)%$([ "$(pamixer --get-mute 2>/dev/null)" = true ] && echo ', звук выключен')"
command -v brightnessctl >/dev/null && echo "яркость: $(( 100 * $(brightnessctl get) / $(brightnessctl max) ))%"
command -v playerctl >/dev/null && playerctl status >/dev/null 2>&1 \
  && echo "плеер: $(playerctl status) — $(playerctl metadata --format '{{artist}} — {{title}}' 2>/dev/null)"

if command -v hyprctl >/dev/null; then
  hyprctl activewindow -j 2>/dev/null | jq -r 'if .class then "активное окно: \(.class) — \(.title) (ws \(.workspace.id))" else "активное окно: нет" end'
  echo "воркспейсы:"
  hyprctl clients -j | jq -r '
    [.[] | select(.workspace.id > 0 and .class != "capri-desktop")]
    | group_by(.workspace.id)[]
    | "  \(.[0].workspace.id): " + ([.[] | .class] | unique | join(", "))'
fi

msgr=()
for p in Telegram telegram-desktop vesktop discord Discord signal-desktop element-desktop slack whatsapp; do
  pgrep -x "${p:0:15}" >/dev/null && msgr+=("$p")
done
echo "мессенджеры: ${msgr[*]:-не запущены}"
